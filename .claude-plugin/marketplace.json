{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "fortran-lsp",
  "description": "Fortran Language Server (fortls) marketplace for Claude Code",
  "owner": {
    "name": "Ricardo Frantz",
    "url": "https://github.com/ricardofrantz"
  },
  "plugins": [
    {
      "name": "fortls-lsp",
      "description": "Fortran language server (fortls) for code intelligence and diagnostics",
      "version": "1.2.0",
      "author": {
        "name": "Ricardo Frantz",
        "url": "https://github.com/ricardofrantz"
      },
      "source": "./plugins/fortls-lsp",
      "homepage": "https://fortls.fortran-lang.org/",
      "repository": "https://github.com/ricardofrantz/fortran-lsp",
      "license": "MIT",
      "keywords": [
        "fortran",
        "fortls",
        "lsp",
        "language-server",
        "hpc",
        "scientific-computing"
      ],
      "category": "development",
      "strict": false,
      "lspServers": {
        "fortls": {
          "command": "fortls",
          "args": ["--notify_init"],
          "startupTimeout": 120000,
          "extensionToLanguage": {
            ".f": "fortran",
            ".f90": "fortran",
            ".f95": "fortran",
            ".f03": "fortran",
            ".f08": "fortran",
            ".f77": "fortran",
            ".fpp": "fortran",
            ".F": "fortran",
            ".F90": "fortran",
            ".F95": "fortran",
            ".F03": "fortran",
            ".F08": "fortran",
            ".F77": "fortran",
            ".FPP": "fortran",
            ".for": "fortran",
            ".FOR": "fortran"
          }
        }
      }
    }
  ]
}
