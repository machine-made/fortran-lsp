{
  "$schema": "https://anthropic.com/claude-code/plugin.schema.json",
  "name": "fortls-lsp",
  "displayName": "Fortran (fortls + gfortran)",
  "version": "1.3.0",
  "description": "gfortran compile checks after every Fortran edit, runtime debugging and modern Fortran conventions, plus fortls code intelligence in Claude Code",
  "author": {
    "name": "Ricardo Frantz",
    "url": "https://github.com/machine-made"
  },
  "homepage": "https://github.com/machine-made/fortran-lsp",
  "repository": "https://github.com/machine-made/fortran-lsp",
  "supportUrl": "https://github.com/machine-made/fortran-lsp/issues",
  "privacyPolicyUrl": "https://github.com/machine-made/fortran-lsp/blob/main/plugins/fortls-lsp/README.md#privacy",
  "license": "MIT",
  "keywords": ["fortran", "fortls", "gfortran", "lsp", "language-server", "hpc", "scientific-computing"],
  "icon": "./.claude-plugin/icon.png",
  "lspServers": {
    "fortls": {
      "command": "fortls",
      "args": [
        "--notify_init",
        "--disable_autoupdate"
      ],
      "startupTimeout": 120000,
      "extensionToLanguage": {
        ".f": "fortran",
        ".f90": "fortran",
        ".f95": "fortran",
        ".f03": "fortran",
        ".f08": "fortran",
        ".f77": "fortran",
        ".fpp": "fortran",
        ".F": "fortran",
        ".F90": "fortran",
        ".F95": "fortran",
        ".F03": "fortran",
        ".F08": "fortran",
        ".F77": "fortran",
        ".FPP": "fortran",
        ".for": "fortran",
        ".FOR": "fortran"
      }
    }
  }
}
